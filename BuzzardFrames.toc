# Salvaged oUF elements -- BuzzardFrames-owned, kept OUT of Libs/oUF so the
# vendored library stays a pristine upstream copy. Both were removed upstream
# but are still wired by our unit frames. They register through oUF's public
# extension API, so they must load AFTER oUF.xml (which creates ns.oUF) and
# BEFORE the first frame is spawned in UnitFrames\oUF_Player.lua.
UnitFrames\oUFElements\healthprediction.lua
UnitFrames\oUFElements\pingindicator.lua

# Core files
Defaults.lua
# Load-time harness (perf plan §L5). Must be the FIRST file after
# Defaults.lua: it needs BF to exist, but has to be able to stamp a mark
# before any other chunk runs. Adopts the origin table stamped at the top
# of Defaults.lua. Registers /bf loadreport (dispatched from
# Core_ChatCommands.lua).
LoadTiming.lua
Defaults_RaidPartyFrames.lua
UnitFrames\Defaults_UnitFrames.lua
AuraCustomizations\Defaults_AuraCustomizations.lua
CustomFrameGroups\Defaults_CustomFrameGroups.lua
IncomingCasts\Defaults_IncomingCasts.lua
Core.lua
# P-1 chokepoint: the ONLY file that talks to the options panel
# implementation. Must load after Core.lua (needs the BF object) and
# before anything that calls BF:RefreshPanel / BF:IsOptionsShown /
# BF:ShowTextWindow -- all of which are runtime calls, so position
# here is about clarity, not necessity.
Core_OptionsBridge.lua
# Shared event subscription layer (event refactor stage 0). Must load after
# Core.lua (needs the BF object) and before every consumer -- statuses,
# indicators and unit frames all come later. Gives each module its own
# AceEvent owner, so two modules can hold the same event without the
# (object, event) collision that produced 27 hand-rolled event frames, and
# makes the unit scope a required, engine-enforced argument.
BFEvents.lua
Core_ProfileAPI.lua
Core_FlatDefaults.lua
Core_Migrations.lua
Core_DB.lua
Core_ProfileLifecycle.lua
Core_UFLayout.lua
Core_Refresh.lua
Core_UI.lua
Core_ChatCommands.lua
ProfileExport.lua
# One-time account-wide notifications. Must be after Core_DB, which
# captures BF._freshInstall that the new-user suppression depends on.
Core_Notifications.lua

# Curated buff list (Buffs > Buff List "Spell Name or ID" suggestions).
# SpellData_Buffs.lua builds ns.SpellData; SpellSuggest.lua exposes the
# same rows as a plain function on the addon table for the options addon,
# which cannot see this addon's private table. Data file first.
SpellSearch\SpellData_Buffs.lua
SpellSearch\SpellSuggest.lua

